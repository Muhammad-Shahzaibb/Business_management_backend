# Copy this file to .env and fill in real values. Never commit .env.

# --- Central superadmin database (required) ---
# Supabase Postgres connection string of the ONE central project.
# It stores the organization registry, the login directory and the
# superadmin portal accounts. Every organization has its OWN Supabase
# project; its credentials are entered through the superadmin portal and
# stored in this database - they never appear in .env.
# (Supabase Dashboard -> Connect -> Session pooler / Direct connection.
#  Include ?sslmode=require if your project requires it.)
SUPERADMIN_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth (required) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="change-me"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS="http://localhost:8080"

# --- Groq AI (optional; AI summaries in exports are skipped if empty) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# --- Docker ---
BACKEND_PORT=8000

# --- Security ---
# Failed logins allowed per email+IP before a temporary lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Serve /docs, /redoc, /openapi.json (true only for local development)
ENABLE_API_DOCS=false

# --- Business details (printed on invoices and reports) ---
BUSINESS_NAME="Hisaab"
BUSINESS_ADDRESS=""
BUSINESS_PHONE=""
